# Optional settings for docker/docker-compose.local.yml.
HTTP_PORT=8080
BASE_URL=http://localhost:8080

# Frontend build-time JSON list, combined with 16 fixed practice messages.
# Banner always visible; one random message/page load (21 with these defaults).
# Leave unset/blank for defaults; [] removes vax messages only. Rebuild to apply.
VAX_BANNER_MESSAGES='["vax types faster than his shadow.","the spacebar works overtime for vax.","vax called. your keyboard wants a rematch.","somewhere, vax just broke the sound barrier.","this keyboard has been blessed by vax."]'
